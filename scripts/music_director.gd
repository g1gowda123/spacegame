extends Node
## Screen music: three looping beds, crossfaded on context change, ducked while
## the sector shows a live hazard telegraph.
##
## The beds are generated by `tools/make_music.py`. This director deliberately
## knows nothing about their contents — only context names, loop lengths and
## levels — so a sourced stem can replace a generated one at the same path
## without touching any screen code.
##
## Headless runs (smoke tests, capture probes, CI) return before loading
## anything, so the audio-free ObjectDB/resource-leak checks stay green.

const BEDS := {
	"title": "res://assets/music/title.ogg",
	"sector": "res://assets/music/sector.ogg",
	"debrief": "res://assets/music/debrief.ogg",
}

## Screens that share a bed. report reuses debrief; design/draft/crew reuse
## title, so moving between the meta screens does not restart the loop.
const CONTEXT_BED := {
	"title": "title",
	"design": "title",
	"draft": "title",
	"crew": "title",
	"sector": "sector",
	"debrief": "debrief",
	"report": "debrief",
}

## Bed level when nothing is threatening. The beds are loudness-matched to
## -17 dBFS RMS at source, so one number works for all three.
const BASE_DB := -7.0
## Hazard telegraph is live: pull the bed under the alarm/thud cues.
const DUCK_DB := -13.0
## Crossfade length; 2 s lands within a bar at 84 BPM (bar = 2.86 s).
const FADE_IN := 2.0
const FADE_OUT := 2.0
const DUCK_FADE := 0.35
const SILENT_DB := -60.0

var _players: Array[AudioStreamPlayer] = []
var _streams: Dictionary = {}
var _vol_tweens: Array = []
var _active := 0
var _context := ""
var _bed := ""
var _ducked := false
var _armed := false
var _log := false


func _ready() -> void:
	_log = _has_arg("--music-log")
	if DisplayServer.get_name() == "headless":
		return
	for bed in BEDS:
		var stream: AudioStream = load(str(BEDS[bed]))
		if stream == null:
			push_warning("MusicDirector: missing bed %s" % bed)
			continue
		stream = _loop_forever(stream)
		_streams[bed] = stream
	for i in range(2):
		var player := AudioStreamPlayer.new()
		player.bus = "Master"
		player.volume_db = SILENT_DB
		add_child(player)
		_players.append(player)
		_vol_tweens.append(null)
	_armed = _players.size() == 2


func _has_arg(flag: String) -> bool:
	return flag in OS.get_cmdline_args() or flag in OS.get_cmdline_user_args()


func _loop_forever(stream: AudioStream) -> AudioStream:
	if stream is AudioStreamOggVorbis:
		var ogg := stream as AudioStreamOggVorbis
		ogg.loop = true
		ogg.loop_offset = 0.0
	elif stream is AudioStreamWAV:
		(stream as AudioStreamWAV).loop_mode = AudioStreamWAV.LOOP_FORWARD
	return stream


## Switch beds. Safe to call every `_ready`; same-bed calls are a no-op, which
## is what lets design -> draft -> title continue the loop instead of restarting.
func play(context: String) -> void:
	_context = context
	if not _armed:
		return
	var bed := str(CONTEXT_BED.get(context, context))
	if bed == _bed:
		return
	if not _streams.has(bed):
		return
	_bed = bed
	var next_index := 1 - _active
	var next: AudioStreamPlayer = _players[next_index]
	var previous: AudioStreamPlayer = _players[_active]
	next.stream = _streams[bed]
	next.volume_db = SILENT_DB
	next.play()
	_active = next_index
	var target := DUCK_DB if _ducked else BASE_DB
	_fade_voice(next_index, target, FADE_IN, false)
	_fade_voice(1 - next_index, SILENT_DB, FADE_OUT, true)
	if _log:
		print("MUSIC bed=%s context=%s fade_in=%.1fs" % [bed, context, FADE_IN])


## Called by the sector whenever a telegraph starts or clears.
func set_duck(on: bool) -> void:
	if on == _ducked:
		return
	_ducked = on
	if not _armed:
		return
	_fade_voice(_active, DUCK_DB if on else BASE_DB, DUCK_FADE, false)
	if _log:
		print("MUSIC duck=%s db=%.1f" % [str(on), DUCK_DB if on else BASE_DB])


func _fade_voice(index: int, db: float, seconds: float, stop_after: bool) -> void:
	var player: AudioStreamPlayer = _players[index]
	var old: Tween = _vol_tweens[index]
	if old != null and old.is_valid():
		old.kill()
	var tween := create_tween()
	tween.tween_property(player, "volume_db", db, seconds)
	if stop_after:
		tween.tween_callback(func() -> void:
			# Guard against a fast A->B->A switch: only silence a voice that is
			# no longer the active one.
			if _players.find(player) != _active:
				player.stop()
				player.stream = null
		)
	_vol_tweens[index] = tween


## Note on shutdown: if the process exits while a Vorbis playback is live,
## Godot checks ObjectDB before the audio server has released the playback, so
## the windowed build can print "N ObjectDB instances were leaked at exit". Those
## instances are the engine's Ogg stream/playback objects, not anything this node
## holds: the references below are dropped, headless never creates a player, and
## the WAV cues do not produce the message. Tracked here so a QA pass does not
## read it as a regression in `game_state.gd`'s teardown.
func _exit_tree() -> void:
	for tween in _vol_tweens:
		if tween != null and tween.is_valid():
			tween.kill()
	_vol_tweens.clear()
	for player in _players:
		player.stop()
		player.stream = null
	_players.clear()
	_streams.clear()
	_armed = false
	_bed = ""
